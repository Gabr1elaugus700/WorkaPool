# Configuração usada para iniciar o RabbitMQ dos testes de integração.
# As credenciais são exclusivas do ambiente de teste.

COMPOSE_NAME=WorkaPool_Compose_Test

# Variáveis necessárias para a definição do serviço rabbitmq,
# mesmo quando somente rabbitmq-test for iniciado.
RABBITMQ_CONTAINER=workapool_rabbitmq_compose_test
RABBITMQ_USER=workapool_test
RABBITMQ_PASSWORD=workapool_test_password
RABBITMQ_VHOST=workapool_test
RABBITMQ_AMQP_PORT=5677
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_DATA_VOLUME=workapool_rabbitmq_compose_test_data

# RabbitMQ usado pelos testes executados fora do Docker.
RABBITMQ_TEST_CONTAINER=workapool_rabbitmq_test
RABBITMQ_TEST_USER=workapool_test
RABBITMQ_TEST_PASSWORD=workapool_test_password
RABBITMQ_TEST_VHOST=workapool_test
RABBITMQ_TEST_PORT=5676

# Variável obrigatória no docker-compose.yml.
VITE_API_BASE_URL=http://localhost:3666
