# Copy to docker-compose.env and pass it with:
# docker compose --env-file docker-compose.env --profile production up
RABBITMQ_USER=workapool
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_VHOST=workapool
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

VITE_API_BASE_URL=http://localhost:3001
ENV_FILE=./backend/.env.development
