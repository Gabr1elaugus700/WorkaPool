PORT=3001
API_SERVER_URL=http://localhost
DATABASE_URL=postgresql://user:password@localhost:5432/workapool
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_USER=sapiens
DB_PASSWORD=replace-with-sapiens-password
DB_NAME=sapiens

# RabbitMQ — use a dedicated user/vhost per environment.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=workapool
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_VHOST=workapool
RABBITMQ_EXCHANGE=workapool.domain.events
RABBITMQ_DEAD_LETTER_EXCHANGE=workapool.domain.events.dlx
RABBITMQ_IBC_QUEUE=workapool.ibc.carga-fechada
RABBITMQ_IBC_DLQ=workapool.ibc.dead-letter
RABBITMQ_MAX_RETRIES=3
